# yaml-language-server: $schema=https://devenv.sh/devenv.schema.json
inputs:
  nixpkgs:
    url: github:cachix/devenv-nixpkgs/rolling
  # devenv-dagger's top-level.nix pulls in upstream devenv modules via this input.
  upstream-devenv:
    url: github:cachix/devenv?dir=src/modules
  # The dagger module reads the dagger CLI package from this input.
  dagger-nix:
    url: github:dagger/nix
    inputs:
      nixpkgs:
        follows: nixpkgs
  devenv-dagger:
    url: github:jfroche/devenv-dagger?dir=src/modules
imports:
  - devenv-dagger
